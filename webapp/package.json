{
  "private": true,
  "engines": {
    "node": "^24.14",
    "npm": "^11"
  },
  "scripts": {
    "preinstall": "./install_mattermost_webapp.sh",
    "build": "webpack --mode=production",
    "build:watch": "webpack --mode=production --watch",
    "debug": "webpack --mode=development",
    "debug:watch": "webpack --mode=development --watch",
    "lint": "eslint --ext .js,.jsx,.tsx,.ts . --quiet --cache",
    "lint:fix": "eslint --ext .js,.jsx,.tsx,.ts . --quiet --fix --cache",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "jest --forceExit --detectOpenHandles --verbose",
    "test-ci": "jest --ci --forceExit --maxWorkers=100%",
    "check-types": "tsc",
    "extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore 'src/**/*.d.ts' --out-file i18n/temp.json --id-interpolation-pattern '[sha512:contenthash:base64:6]' && formatjs compile 'i18n/temp.json' --out-file i18n/en.json && rm i18n/temp.json"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@mattermost/calls-common": "github:mattermost/calls-common#59e41e8f8f2211490a36fed3a9f8e7b7d2140e20",
    "@mediapipe/tasks-vision": "0.10.35",
    "@msgpack/msgpack": "2.8.0",
    "@redux-devtools/extension": "3.3.0",
    "core-js": "3.51.0",
    "emoji-picker-react": "4.22.3",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "media-chrome": "0.21.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "8.1.3",
    "react-router-dom": "5.3.4",
    "react-select": "5.10.2",
    "redux": "4.2.0",
    "redux-batched-actions": "0.5.0",
    "semver-parser": "4.2.2",
    "styled-components": "6.1.8",
    "stylis": "4.4.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/eslint-parser": "7.29.13",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-proposal-optional-chaining": "7.21.0",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@formatjs/cli": "5.1.13",
    "@mattermost/client": "file:mattermost-webapp/webapp/platform/client",
    "@mattermost/desktop-api": "6.3.0-2",
    "@mattermost/eslint-plugin": "1.1.0-0",
    "@mattermost/types": "file:mattermost-webapp/webapp/platform/types",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "27.5.2",
    "@types/lodash": "4.17.27",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-bootstrap": "0.32.37",
    "@types/react-dom": "18.3.7",
    "@types/react-intl": "3.0.0",
    "@types/react-router-dom": "5.3.3",
    "@types/shallow-equals": "1.0.3",
    "babel-loader": "8.4.1",
    "babel-plugin-formatjs": "10.5.41",
    "babel-plugin-styled-components": "2.4.0",
    "babel-plugin-typescript-to-proptypes": "2.1.0",
    "css-loader": "5.2.7",
    "eslint": "8.57.1",
    "eslint-import-resolver-webpack": "0.13.11",
    "eslint-plugin-formatjs": "4.13.0",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "3.2.0",
    "file-loader": "6.2.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "27.5.1",
    "jest-canvas-mock": "2.5.8",
    "jest-junit": "12.3.0",
    "luxon": "3.7.2",
    "mattermost-webapp": "file:mattermost-webapp/webapp/channels",
    "process": "0.11.10",
    "react-intl": "6.8.9",
    "redux-thunk": "2.4.2",
    "sass": "1.108.1",
    "sass-loader": "13.3.3",
    "style-loader": "3.3.4",
    "terser-webpack-plugin": "5.6.1",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "4.10.0"
  },
  "overrides": {
    "@mattermost/desktop-api": {
      "typescript": "$typescript"
    },
    "react": "$react",
    "react-dom": "$react-dom",
    "react-redux": "$react-redux"
  }
}
