{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react",
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "src/*": [
        "./src/*",
        "../webapp/src/*"
      ],
      "plugin/*": [
        "../webapp/src/*"
      ]
    }
  },
  "include": [
    "./**/*",
    "../webapp/src/types/global.d.ts",
    "../webapp/src/types/semver-parser/*",
    "../webapp/src/types/static/*"
  ],
  "exclude": [
    "dist"
  ]
}
